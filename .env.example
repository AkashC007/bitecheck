# Server-only URL used by Next.js to reach FastAPI.
API_BASE_URL=http://127.0.0.1:8000

# Hosting platforms can supply a private host:port instead of a public URL.
# API_BASE_HOSTPORT=bitecheck-api:10000

# Optional: allow a sleeping free backend time to start on the first page load.
# API_HEALTH_TIMEOUT_MS=60000

# Optional backend override. The default is data/synthetic/restaurants.json.
# RESTAURANT_DATA_PATH=/absolute/path/to/restaurants.json

# Add backend-only secrets below as placeholder names, never real values.
# DATABASE_URL=postgresql://user:password@host:5432/database
